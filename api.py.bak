<div class="modal" id="modal">
  <div class="modal-content">
    <button class="close-btn" onclick="closeModal()">✕</button>
    <h2 id="modalTitle">Audit Report</h2>
    <div id="modalBody"></div>
  </div>
</div>
<div class="toast" id="toast"></div>
<script>
function updateFileLabel(input) { document.getElementById('fileLabel').textContent = input.files[0]?.name || 'Click to select audio file'; }
async function submitAudit() {
  const file = document.getElementById('audioFile').files[0];
  if (!file) { showToast('Please select an audio file'); return; }
  const btn = document.getElementById('auditBtn');
  const loading = document.getElementById('loading');
  btn.disabled = true; loading.classList.add('show');
  const formData = new FormData();
  formData.append('file', file);
  formData.append('client_name', document.getElementById('clientName').value);
  formData.append('agent_name', document.getElementById('agentName').value);
  try {
    const res = await fetch('/audit', { method: 'POST', body: formData });
    const report = await res.json();
    if (!res.ok) throw new Error(report.detail || 'Audit failed');
    showToast('✅ Audit complete! Score: ' + report.overall_score + '/10');
  // Show usage banner
  if (report.calls_used !== undefined) {
    const used = report.calls_used;
    const limit = report.calls_limit;
    const remaining = report.calls_remaining;
    const banner = document.getElementById('usageBanner');
    const upgradeWall = document.getElementById('upgradeWall');
    if (used >= limit) {
      banner.style.display = 'none';
      upgradeWall.style.display = 'block';
      document.querySelector('.upload-card').style.display = 'none';
    } else if (used >= 40) {
      banner.style.display = 'block';
      banner.style.background = '#fff3cd';
      banner.style.border = '1px solid #ffc107';
      banner.style.color = '#856404';
      banner.innerHTML = '⚠️ <strong>Warning:</strong> You have used ' + used + '/' + limit + ' trial calls. Only ' + remaining + ' calls remaining. <a href="https://auditiq.nxtautomation.online/#pricing" style="color:#856404; font-weight:700;">Upgrade now →</a>';
    } else {
      banner.style.display = 'block';
      banner.style.background = '#e8f5e9';
      banner.style.border = '1px solid #4caf50';
      banner.style.color = '#2e7d32';
      banner.innerHTML = '✅ <strong>' + remaining + ' trial calls remaining</strong> (' + used + '/' + limit + ' used)';
    }
  }
    loadReports(); showModal(report);
  } catch (e) { showToast('❌ Error: ' + e.message); }
  finally { btn.disabled = false; loading.classList.remove('show'); }
}
async function loadReports() {
  const res = await fetch('/reports');
  const data = await res.json();
  const reports = data.reports || [];
  document.getElementById('totalCalls').textContent = reports.length;
  if (reports.length > 0) {
    const avg = reports.reduce((s, r) => s + (r.overall_score || 0), 0) / reports.length;
    document.getElementById('avgScore').textContent = avg.toFixed(1);
    document.getElementById('flaggedCalls').textContent = reports.filter(r => r.recommendation === 'critical_review' || r.recommendation === 'coaching_needed').length;
    const compliant = reports.filter(r => r.compliance_passed).length;
    document.getElementById('complianceRate').textContent = Math.round(compliant / reports.length * 100) + '%';
  }
  const tbody = document.getElementById('reportsBody');
  if (reports.length === 0) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:#888;padding:40px">No audits yet.</td></tr>'; return; }
  tbody.innerHTML = reports.map(r => {
    const score = r.overall_score || 0;
    const sc = score >= 8 ? 'score-high' : score >= 6 ? 'score-mid' : 'score-low';
    const rc = {excellent:'rec-excellent',good:'rec-good',coaching_needed:'rec-coaching',critical_review:'rec-critical'}[r.recommendation] || '';
    const date = r.audited_at ? new Date(r.audited_at).toLocaleDateString('en-IN') : '-';
    const sent = r.customer_sentiment ? `${r.customer_sentiment.start} → ${r.customer_sentiment.end}` : '-';
    return `<tr>
      <td>${r.file||'-'}</td><td>${r.agent_name||'-'}</td>
      <td><span class="score-badge ${sc}">${score}/10</span></td>
      <td style="font-size:12px">${sent}</td>
      <td class="${r.compliance_passed?'compliance-yes':'compliance-no'}">${r.compliance_passed?'✅ Pass':'❌ Fail'}</td>
      <td><span class="rec-badge ${rc}">${(r.recommendation||'').replace('_',' ')}</span></td>
      <td>${date}</td>
      <td><button class="view-btn" onclick="viewReport('${r.audit_id}')">View</button></td>
    </tr>`;
  }).join('');
}
async function viewReport(id) {
  const res = await fetch('/reports/' + id);
  showModal(await res.json());
}
function showModal(report) {
  const scores = report.scores || {};
  const sentiment = report.customer_sentiment || {};
  document.getElementById('modalTitle').textContent = `Audit: ${report.file || report.audit_id}`;
  document.getElementById('modalBody').innerHTML = `
    <p style="color:#888;margin-bottom:16px">${report.call_summary||''}</p>
    <div class="scores-grid">${Object.entries(scores).map(([k,v])=>`
      <div class="score-item">
        <div class="val" style="color:${v>=8?'#2e7d32':v>=6?'#f57f17':'#c62828'}">${v}/10</div>
        <div class="name">${k.charAt(0).toUpperCase()+k.slice(1)}</div>
      </div>`).join('')}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px">
      <div style="background:#f8f9fa;border-radius:8px;padding:12px;text-align:center">
        <div style="font-weight:600">${sentiment.start||'-'} → ${sentiment.end||'-'}</div>
        <div style="font-size:12px;color:#888">Customer Sentiment</div>
      </div>
      <div style="background:#f8f9fa;border-radius:8px;padding:12px;text-align:center">
        <div style="font-weight:600">${report.resolution_status||'-'}</div>
        <div style="font-size:12px;color:#888">Resolution</div>
      </div>
      <div style="background:#f8f9fa;border-radius:8px;padding:12px;text-align:center">
        <div style="font-weight:600;color:${report.compliance_passed?'#2e7d32':'#c62828'}">${report.compliance_passed?'✅ Passed':'❌ Failed'}</div>
        <div style="font-size:12px;color:#888">Compliance</div>
      </div>
    </div>
    ${report.flags?.length?`<div class="section-title">⚠️ Flags</div>${report.flags.map(f=>`<div class="flag-item">${f}</div>`).join('')}`:''}
    ${report.strengths?.length?`<div class="section-title">💪 Strengths</div>${report.strengths.map(s=>`<div class="strength-item">${s}</div>`).join('')}`:''}
    ${report.improvement_areas?.length?`<div class="section-title">📈 Coaching Areas</div><ul style="padding-left:18px;font-size:14px;line-height:2">${report.improvement_areas.map(a=>`<li>${a}</li>`).join('')}</ul>`:''}
    ${report.full_transcript?`<div class="section-title">📝 Transcript</div><div class="transcript-box">${report.full_transcript}</div>`:''}
  `;
  document.getElementById('modal').classList.add('open');
}
function closeModal() { document.getElementById('modal').classList.remove('open'); }
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 4000);
}
loadReports();
setInterval(loadReports, 30000);
function updateBatchLabel(input) {
  const count = input.files.length;
  document.getElementById('batchFileLabel').textContent = count > 0 ? `${count} file(s) selected` : 'Click to select multiple audio files';
}

async function submitBatch() {
  const files = document.getElementById('batchFiles').files;
  if (!files.length) { showToast('Please select audio files'); return; }
  const btn = document.getElementById('batchBtn');
  const loading = document.getElementById('batchLoading');
  const progress = document.getElementById('batchProgress');
  btn.disabled = true;
  loading.classList.add('show');
  progress.textContent = `Uploading ${files.length} files...`;

  const formData = new FormData();
  for (const file of files) formData.append('files', file);
  formData.append('client_name', document.getElementById('batchClientName').value);

  try {
    const res = await fetch('/audit/batch', { method: 'POST', body: formData });
    const data = await res.json();
    if (!res.ok) throw new Error(data.detail || 'Batch failed');
    const success = data.results.filter(r => r.status === 'success').length;
    const failed = data.results.filter(r => r.status === 'failed').length;
    progress.innerHTML = `✅ <strong>${success} audited</strong> ${failed > 0 ? `❌ ${failed} failed` : ''}`;
    showToast(`✅ Batch complete! ${success}/${files.length} calls audited`);
    loadReports();
  } catch (e) {
    showToast('❌ Error: ' + e.message);
    progress.textContent = '';
  } finally {
    btn.disabled = false;
    loading.classList.remove('show');
  }
}
</script>
</body>
</html>"""

from leads import handle_new_lead, get_all_leads


@app.post("/leads")
async def create_lead(
    name: str = Form(...),
    email: str = Form(...),
    company: str = Form(...),
    volume: str = Form(default=""),
    plan: str = Form(default="trial"),
):
    try:
        # Save lead
        await handle_new_lead(name, email, company, volume, plan)
        # Create user account
        create_or_get_user(email, name, company, plan)
        # Generate and send magic link
        token = create_magic_token(email)
        await send_magic_link(email, name, token)
        return {"success": True, "message": "Account created! Check your email for dashboard access."}
    except Exception as e:
        raise HTTPException(500, f"Failed: {str(e)}")

# ── Auth: Verify magic link ─────────────────────────────────────────────────────
@app.get("/auth/verify")
async def verify_magic_link(token: str):
    user = get_user_by_token(token)
    if not user:
        return HTMLResponse("<h2>❌ Link expired or invalid. Please request a new one from auditiq.nxtautomation.online</h2>")
    session_token = create_session_token(user["email"])
    response = RedirectResponse(url="/dashboard")
    response.set_cookie(key="session", value=session_token, max_age=604800, httponly=True, samesite="lax")
    return response

# ── Auth: Request magic link ────────────────────────────────────────────────────
@app.post("/auth/login")
async def request_magic_link(email: str = Form(...)):
    from auth import get_user_by_email
    user = get_user_by_email(email)
    if not user:
        raise HTTPException(404, "No account found with this email. Please sign up first.")
    token = create_magic_token(email)
    await send_magic_link(email, user["name"], token)
    return {"success": True, "message": "Magic link sent to your email"}

# ── Auth: Check session ─────────────────────────────────────────────────────────
@app.get("/auth/me")
async def get_me(session: str = Cookie(default=None)):
    if not session:
        raise HTTPException(401, "Not authenticated")
    user = verify_session_token(session)
    if not user:
        raise HTTPException(401, "Session expired")
    limit_status = check_call_limit(user["email"])
    return {**user, "limit_status": limit_status}

@app.get("/")
async def root():
    return {"message": "Call Quality Auditor API", "dashboard": "/dashboard", "docs": "/docs"}
