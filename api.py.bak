import os, json, uuid, asyncio
from pathlib import Path
from datetime import datetime
from fastapi import FastAPI, UploadFile, File, Form, HTTPException, Cookie
from fastapi.responses import HTMLResponse, JSONResponse, RedirectResponse
from fastapi.middleware.cors import CORSMiddleware
from dotenv import load_dotenv
from auth import (create_or_get_user, create_magic_token, get_user_by_token,
                  create_session_token, verify_session_token, check_call_limit,
                  increment_call_count, send_magic_link)

load_dotenv()
from auditor import audit_call, DEFAULT_CRITERIA

app = FastAPI(title="Call Quality Auditor", version="1.0.0")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

UPLOAD_DIR = Path("uploads")
REPORTS_DIR = Path("reports")
UPLOAD_DIR.mkdir(exist_ok=True)
REPORTS_DIR.mkdir(exist_ok=True)

@app.post("/audit")
async def audit_single_call(
    file: UploadFile = File(...),
    client_name: str = Form(default=""),
    criteria: str = Form(default=DEFAULT_CRITERIA),
    agent_name: str = Form(default=""),
    session: str = Cookie(default=None),
):
    # Check authentication and call limit
    user = None
    if session:
        user = verify_session_token(session)
    if user:
        limit = check_call_limit(user["email"])
        if not limit["allowed"]:
            raise HTTPException(403, f"Trial limit reached. You've used {limit['used']}/{limit['limit']} calls. Please upgrade at auditiq.nxtautomation.online")

    if not file.filename.endswith((".mp3", ".wav", ".m4a", ".ogg")):
        raise HTTPException(400, "Only audio files supported: mp3, wav, m4a, ogg")

    file_id = str(uuid.uuid4())[:8]
    file_path = UPLOAD_DIR / f"{file_id}_{file.filename}"
    with open(file_path, "wb") as f:
        f.write(await file.read())

    context = f"Client: {client_name}. Agent: {agent_name}." if client_name else ""
    try:
        report = await audit_call(str(file_path), criteria, context, save_report=False)
    except Exception as e:
        raise HTTPException(500, f"Audit failed: {str(e)}")

    report["client_name"] = client_name
    report["agent_name"] = agent_name
    report["audit_id"] = file_id
    report["user_email"] = user["email"] if user else "anonymous"

    # Track usage
    if user:
        updated_user = increment_call_count(user["email"])
        report["calls_used"] = updated_user["calls_used"]
        report["calls_limit"] = updated_user["calls_limit"]
        report["calls_remaining"] = updated_user["calls_limit"] - updated_user["calls_used"]
        if updated_user["calls_used"] >= 40:
            report["warning"] = f"⚠️ You've used {updated_user['calls_used']}/{updated_user['calls_limit']} trial calls. Upgrade soon!"

    with open(REPORTS_DIR / f"{file_id}.json", "w") as f:
        json.dump(report, f, indent=2, ensure_ascii=False)

    return JSONResponse(report)

@app.post("/audit/batch")
async def audit_batch_calls(
    files: list[UploadFile] = File(...),
    client_name: str = Form(default=""),
    criteria: str = Form(default=DEFAULT_CRITERIA),
):
    results = []
    for file in files:
        file_id = str(uuid.uuid4())[:8]
        file_path = UPLOAD_DIR / f"{file_id}_{file.filename}"
        with open(file_path, "wb") as f:
            f.write(await file.read())
        try:
            report = await audit_call(str(file_path), criteria, f"Client: {client_name}", save_report=False)
            report["audit_id"] = file_id
            report["client_name"] = client_name
            with open(REPORTS_DIR / f"{file_id}.json", "w") as f:
                json.dump(report, f, indent=2, ensure_ascii=False)
            results.append({"file": file.filename, "audit_id": file_id, "status": "success", "score": report.get("overall_score")})
        except Exception as e:
            results.append({"file": file.filename, "status": "failed", "error": str(e)})
    return {"total": len(files), "results": results}

@app.get("/reports")
async def list_reports(session: str = Cookie(default=None)):
    user = verify_session_token(session) if session else None
    user_email = user["email"] if user else None
    reports = []
    for rf in sorted(REPORTS_DIR.glob("*.json"), reverse=True):
        with open(rf) as f:
            data = json.load(f)
        # Filter by user email - only show own reports
        report_email = data.get("user_email", "anonymous")
        if user_email and report_email != user_email:
            continue
        if not user_email and report_email != "anonymous":
            continue
        reports.append({
            "audit_id": data.get("audit_id"),
            "file": data.get("file"),
            "audited_at": data.get("audited_at"),
            "overall_score": data.get("overall_score"),
            "recommendation": data.get("recommendation"),
            "compliance_passed": data.get("compliance_passed"),
            "resolution_status": data.get("resolution_status"),
            "client_name": data.get("client_name", ""),
            "agent_name": data.get("agent_name", ""),
        })
    return {"total": len(reports), "reports": reports}

@app.get("/reports/{audit_id}")
async def get_report(audit_id: str):
    report_path = REPORTS_DIR / f"{audit_id}.json"
    if not report_path.exists():
        raise HTTPException(404, "Report not found")
    with open(report_path) as f:
        return json.load(f)

